---
import logo from '../assets/brand/usai-logo-white-no-tagline.svg?raw';
import { usai } from '../config/site';
import { t, localePath, locales, localeMeta, type Lang } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const d = t(lang);

const links = [
  { href: localePath(lang, '/#how'), label: d.nav.how, match: '/#how' },
  { href: localePath(lang, '/benchmarks/'), label: d.nav.evidence, match: '/benchmarks/' },
  { href: localePath(lang, '/research/'), label: d.nav.research, match: '/research/' },
  { href: localePath(lang, '/glossary/'), label: d.nav.glossary, match: '/glossary/' },
];
const logoSvg = logo.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---

<header class="site-header fixed inset-x-0 top-0 z-50" data-header>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={localePath(lang, '/')} class="logo -ml-1 flex items-center rounded-md p-1" aria-label={d.nav.home}>
      <span class="block h-7 w-auto [&>svg]:h-7 [&>svg]:w-auto" set:html={logoSvg} />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 lg:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:text-paper"
            aria-current={path === l.match ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
      <a href={usai.guide} class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:text-paper" rel="noopener">
        {d.nav.docs}
      </a>
    </nav>

    <div class="flex items-center gap-2">
      <div class="lang-switch hidden items-center rounded-lg border border-line p-0.5 text-xs sm:flex" role="group" aria-label={d.nav.language}>
        {
          locales.map((l) => (
            <a
              href={localePath(l, path)}
              hreflang={localeMeta[l].htmlLang}
              lang={localeMeta[l].htmlLang}
              aria-current={l === lang ? 'true' : undefined}
              class:list={[
                'rounded-md px-2 py-1 font-mono tracking-wider transition-colors',
                l === lang ? 'bg-white/10 text-paper' : 'text-dim hover:text-paper',
              ]}
              title={localeMeta[l].label}
            >
              {localeMeta[l].short}
            </a>
          ))
        }
      </div>
      <a href={usai.repo} class="btn btn-ghost hidden !min-h-9 !px-3 !py-1.5 text-sm sm:inline-flex" rel="noopener">
        <Icon name="github" class="size-4" />
        <span>{d.nav.github}</span>
      </a>
      <button
        type="button"
        class="inline-flex size-10 items-center justify-center rounded-lg border border-line text-paper lg:hidden"
        popovertarget="mobile-nav"
        aria-label={d.nav.menu}
      >
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </div>

  <nav id="mobile-nav" popover="auto" aria-label="Mobile" class="mobile-nav">
    <div class="flex items-center justify-between">
      <span class="eyebrow">{d.nav.menu}</span>
      <button type="button" popovertarget="mobile-nav" popovertargetaction="hide" class="inline-flex size-10 items-center justify-center rounded-lg border border-line text-paper" aria-label={d.nav.close}>
        <Icon name="close" class="size-5" />
      </button>
    </div>
    <ul class="mt-6 flex flex-col">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="block border-b border-line py-4 font-heading text-2xl text-paper" data-close-nav>
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={usai.guide} class="block border-b border-line py-4 font-heading text-2xl text-paper" rel="noopener">{d.nav.docs} ↗</a>
      </li>
      <li>
        <a href={usai.repo} class="block border-b border-line py-4 font-heading text-2xl text-paper" rel="noopener">{d.nav.github} ↗</a>
      </li>
    </ul>
    <div class="mt-8 flex gap-2" role="group" aria-label={d.nav.language}>
      {
        locales.map((l) => (
          <a
            href={localePath(l, path)}
            hreflang={localeMeta[l].htmlLang}
            lang={localeMeta[l].htmlLang}
            aria-current={l === lang ? 'true' : undefined}
            class:list={['btn', l === lang ? 'btn-primary' : 'btn-ghost']}
          >
            {localeMeta[l].label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<style>
  .site-header {
    transition:
      background-color 0.3s,
      border-color 0.3s,
      backdrop-filter 0.3s;
    border-bottom: 1px solid transparent;
  }
  .site-header[data-scrolled] {
    background: rgb(3 17 15 / 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--color-line);
  }
  nav a[aria-current='page'] {
    color: var(--color-paper);
  }
  .mobile-nav {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1rem 1.25rem 2rem;
    border: 0;
    background: rgb(3 17 15 / 0.97);
    backdrop-filter: blur(16px);
    overflow-y: auto;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const nav = document.getElementById('mobile-nav');
  document.querySelectorAll('[data-close-nav]').forEach((a) =>
    a.addEventListener('click', () => nav?.hidePopover?.()),
  );
</script>
