---
import SectionHeading from '../SectionHeading.astro';
import Rich from '../Rich.astro';
import Icon from '../Icon.astro';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const f = t(lang).home.fit;
---

<section id="fit" class="section relative" aria-labelledby="fit-title">
  <div class="container-page">
    <SectionHeading {lang} id="fit-title" eyebrow={f.eyebrow} title={f.title} lead={f.lead} />

    <div class="mt-12 grid gap-6 lg:grid-cols-[1.35fr_1fr]">
      <div class="card p-6 sm:p-8" data-reveal>
        <h3 class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-mint"><Icon name="check" class="size-4" /> {f.goodTitle}</h3>
        <ul class="mt-6 space-y-5">
          {
            f.good.map((g) => (
              <li class="grid grid-cols-[auto_1fr] gap-x-3">
                <span class="mt-2 size-2 rounded-full bg-mint shadow-[0_0_10px_rgba(45,212,191,0.7)]" aria-hidden="true" />
                <div>
                  <p class="font-heading font-semibold text-paper">{g.title}</p>
                  <p class="mt-1 text-sm leading-relaxed text-muted"><Rich text={g.body} {lang} /></p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-[1.25rem] border border-caution/25 bg-caution/[0.03] p-6 sm:p-8" data-reveal data-reveal-delay="0.08">
        <h3 class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-caution"><Icon name="close" class="size-4" /> {f.notTitle}</h3>
        <ul class="mt-6 space-y-4">
          {
            f.not.map((n) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted">
                <span aria-hidden="true" class="text-caution">—</span>
                <span><Rich text={n} {lang} /></span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-12" data-reveal>
      <h3 class="text-2xl font-bold sm:text-3xl">{f.realTitle}</h3>
      <p class="mt-3 max-w-3xl text-muted">{f.realLead}</p>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {
          f.quotes.map((q) => (
            <figure class="card flex flex-col p-6">
              <blockquote class="flex-1 font-heading text-lg leading-snug text-paper" lang="en">
                “{q.quote}”
              </blockquote>
              <figcaption class="mt-4 text-sm">
                <a href={q.url} class="link" rel="noopener">
                  {q.who} ↗
                </a>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="mx-auto mt-10 max-w-3xl text-center font-heading text-xl font-semibold text-paper sm:text-2xl">{f.realClosing}</p>
    </div>
  </div>
</section>
