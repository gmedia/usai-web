---
import SectionHeading from '../SectionHeading.astro';
import Rich from '../Rich.astro';
import { t, plain, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = t(lang).home.pipeline;
const bornAt = p.steps.findIndex((s) => s.world === 'born');
const chips = ['ctx', 'globals', 'lease', 'tasks'];
---

<section id="pipeline" class="section relative" aria-labelledby="pipeline-title" data-pipeline>
  <div class="container-page">
    <SectionHeading {lang} id="pipeline-title" eyebrow={p.eyebrow} title={p.title} lead={p.lead} />

    <div class="mt-14 grid gap-10 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <ol class="relative space-y-4 lg:space-y-0">
        <span class="absolute bottom-6 left-[1.05rem] top-6 w-px bg-line lg:hidden" aria-hidden="true"></span>
        {
          p.steps.map((s, i) => (
            <li class="step relative lg:flex lg:min-h-[34vh] lg:items-center" data-step={i} data-world={s.world}>
              <div class="step-card card relative w-full py-5 pl-14 pr-5 sm:py-6 sm:pl-16 sm:pr-6 lg:py-7 lg:pr-7">
                <span class="step-num absolute left-3 top-5 flex size-8 items-center justify-center rounded-full border font-mono text-xs sm:left-4 sm:top-6" aria-hidden="true">
                  {i + 1}
                </span>
                <h3 class="text-lg font-bold sm:text-xl">
                  <Rich text={s.label} {lang} />
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-muted sm:text-base">
                  <Rich text={s.body} {lang} />
                </p>
                <p class:list={['world-chip mt-4 inline-flex items-center gap-2 rounded-full border px-2.5 py-1 font-mono text-[0.7rem] lg:hidden', `is-${s.world}`]}>
                  <span class="size-2 rounded-full" aria-hidden="true" />
                  {s.world === 'none' ? p.noWorld : s.world === 'ends' ? `${p.worldLabel} ✕` : p.worldLabel}
                </p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="hidden lg:block">
        <div class="viz card sticky top-[18vh] overflow-hidden p-6" data-viz data-phase="none" aria-hidden="true">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-dim">Persistent runtime</span>
            <span class="font-mono text-[0.7rem] text-mint">● live</span>
          </div>
          <div class="runtime-bar mt-3"></div>

          <ol class="mt-6 space-y-1.5">
            {
              p.steps.map((s, i) => (
                <li class="viz-step flex items-center gap-3 rounded-lg px-3 py-1.5 text-sm" data-viz-step={i}>
                  <span class="viz-dot size-2 shrink-0 rounded-full" />
                  <span class="truncate">{plain(s.label)}</span>
                  {i === bornAt && <span class="ml-auto font-mono text-[0.65rem] text-mint">+ world</span>}
                  {i === p.steps.length - 1 && <span class="ml-auto font-mono text-[0.65rem] text-caution">− world</span>}
                </li>
              ))
            }
          </ol>

          <div class="world-stage relative mt-6 flex h-48 items-center justify-center rounded-xl border border-line bg-ink/70">
            <div class="world-ghost absolute size-32 rounded-full border border-dashed border-mint/25"></div>
            <div class="world relative flex size-36 flex-wrap content-center items-center justify-center gap-1.5 rounded-full p-5">
              {chips.map((c, i) => (
                <span class="world-chip-in rounded-md bg-ink/70 px-1.5 py-0.5 font-mono text-[0.65rem] text-mint" style={`--i:${i}`}>
                  {c}
                </span>
              ))}
            </div>
            <span class="world-caption absolute bottom-3 font-mono text-[0.7rem] text-dim" data-caption-none>{p.noWorld}</span>
            <span class="world-caption absolute bottom-3 font-mono text-[0.7rem] text-mint" data-caption-alive>{p.worldLabel}</span>
            <span class="world-caption absolute bottom-3 font-mono text-[0.7rem] text-caution" data-caption-ends>{p.worldLabel} ✕</span>
          </div>
        </div>
      </div>
    </div>

    <p class="mx-auto mt-14 max-w-2xl text-center font-heading text-xl font-semibold text-paper sm:text-2xl" data-reveal>
      {p.closing}
    </p>
  </div>
</section>

<style>
  .step-num {
    border-color: var(--color-line);
    color: var(--color-dim);
    background: var(--color-ink);
    transition: all 0.4s var(--ease-out-soft);
  }
  .step-card {
    transition:
      border-color 0.4s,
      background 0.4s,
      opacity 0.4s;
  }
  @media (min-width: 1024px) {
    .step-card {
      opacity: 0.45;
    }
    .step[data-active] .step-card {
      opacity: 1;
      border-color: rgb(45 212 191 / 0.35);
    }
  }
  .step[data-active] .step-num,
  .step[data-past] .step-num {
    border-color: var(--color-mint);
    color: var(--color-ink);
    background: var(--color-mint);
  }

  .world-chip {
    border-color: var(--color-line);
    color: var(--color-dim);
  }
  .world-chip span {
    background: currentColor;
  }
  .world-chip.is-born,
  .world-chip.is-alive {
    border-color: rgb(45 212 191 / 0.4);
    color: var(--color-mint);
  }
  .world-chip.is-ends {
    border-color: rgb(242 197 114 / 0.4);
    color: var(--color-caution);
  }

  .runtime-bar {
    height: 6px;
    border-radius: 9999px;
    background: linear-gradient(90deg, #177971, #4ebfaa, #177971);
    background-size: 200% 100%;
    box-shadow: 0 0 16px rgb(45 212 191 / 0.4);
    animation: flow 4s linear infinite;
  }
  @keyframes flow {
    to {
      background-position: -200% 0;
    }
  }

  .viz-step {
    color: var(--color-dim);
    transition:
      color 0.3s,
      background 0.3s;
  }
  .viz-dot {
    background: rgb(229 231 235 / 0.15);
    transition:
      background 0.3s,
      box-shadow 0.3s;
  }
  .viz-step[data-past] {
    color: var(--color-muted);
  }
  .viz-step[data-past] .viz-dot {
    background: rgb(45 212 191 / 0.5);
  }
  .viz-step[data-active] {
    color: var(--color-paper);
    background: rgb(45 212 191 / 0.08);
  }
  .viz-step[data-active] .viz-dot {
    background: var(--color-mint);
    box-shadow: 0 0 10px var(--color-mint);
  }

  .world {
    opacity: 0;
    transform: scale(0.3);
    filter: blur(8px);
    background: radial-gradient(circle at 35% 30%, rgb(125 232 214 / 0.55), rgb(14 122 114 / 0.35) 60%, rgb(8 61 58 / 0.2));
    box-shadow:
      0 0 0 1px rgb(45 212 191 / 0.5) inset,
      0 0 60px rgb(45 212 191 / 0.35);
    transition:
      opacity 0.6s var(--ease-out-soft),
      transform 0.7s var(--ease-out-soft),
      filter 0.6s;
  }
  .world-chip-in {
    opacity: 0;
    transform: translateY(6px);
    transition: all 0.4s var(--ease-out-soft);
    transition-delay: calc(var(--i) * 70ms + 200ms);
  }
  .world-caption {
    opacity: 0;
    transition: opacity 0.3s;
  }
  [data-phase='none'] [data-caption-none],
  [data-phase='born'] [data-caption-alive],
  [data-phase='alive'] [data-caption-alive],
  [data-phase='ends'] [data-caption-ends] {
    opacity: 1;
  }
  [data-phase='born'] .world,
  [data-phase='alive'] .world {
    opacity: 1;
    transform: scale(1);
    filter: blur(0);
  }
  [data-phase='born'] .world-chip-in,
  [data-phase='alive'] .world-chip-in {
    opacity: 1;
    transform: none;
  }
  [data-phase='alive'] .world {
    animation: breathe 2.4s ease-in-out infinite;
  }
  @keyframes breathe {
    50% {
      transform: scale(1.04);
    }
  }
  [data-phase='ends'] .world {
    opacity: 0;
    transform: scale(1.5);
    filter: blur(14px);
    transition-duration: 1.1s;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-pipeline]').forEach((section) => {
    const steps = Array.from(section.querySelectorAll<HTMLElement>('[data-step]'));
    const viz = section.querySelector<HTMLElement>('[data-viz]');
    const vizSteps = Array.from(section.querySelectorAll<HTMLElement>('[data-viz-step]'));

    const activate = (index: number) => {
      steps.forEach((s, i) => {
        s.toggleAttribute('data-active', i === index);
        s.toggleAttribute('data-past', i < index);
      });
      vizSteps.forEach((s, i) => {
        s.toggleAttribute('data-active', i === index);
        s.toggleAttribute('data-past', i < index);
      });
      if (viz) viz.dataset.phase = steps[index]?.dataset.world ?? 'none';
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) activate(Number((e.target as HTMLElement).dataset.step));
        });
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    steps.forEach((s) => io.observe(s));
    activate(0);
  });
</script>
