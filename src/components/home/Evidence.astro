---
import SectionHeading from '../SectionHeading.astro';
import Rich from '../Rich.astro';
import Icon from '../Icon.astro';
import BenchmarkChart from '../islands/BenchmarkChart.tsx';
import { t, localePath, type Lang } from '../../i18n';
import { sources } from '../../config/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const e = d.home.evidence;
const b = d.benchmarks;
---

<section id="evidence" class="section relative overflow-hidden" aria-labelledby="evidence-title">
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[40rem] bg-[radial-gradient(50%_60%_at_50%_0%,rgb(8_61_58/0.55),transparent)]" aria-hidden="true"></div>
  <div class="container-page">
    <SectionHeading {lang} id="evidence-title" eyebrow={e.eyebrow} title={e.title} lead={e.lead} />

    <ul class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        e.stats.map((s, i) => (
          <li class="group relative bg-ink p-6 transition-colors hover:bg-abyss sm:p-7" data-reveal data-reveal-delay={String((i % 3) * 0.06)}>
            <p class="font-heading text-4xl font-extrabold tracking-tight text-paper sm:text-5xl">{s.value}</p>
            <p class="mt-2 text-sm font-medium text-fog">{s.label}</p>
            <p class="mt-1 text-xs leading-relaxed text-dim">{s.note}</p>
            <a
              href={sources[s.source as keyof typeof sources]}
              class="mt-4 inline-flex items-center gap-1 font-mono text-[0.7rem] text-mint/80 hover:text-mint"
            >
              {d.common.source} <Icon name="arrow" class="size-3" />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-16 grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
      <div data-reveal>
        <h3 class="text-2xl font-bold sm:text-3xl">{e.chartTitle}</h3>
        <p class="mt-3 text-muted"><Rich text={e.chartLead} {lang} /></p>
        <div class="mt-8 rounded-2xl border border-caution/25 bg-caution/[0.04] p-5">
          <p class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-caution">{e.tradeoffTitle}</p>
          <p class="mt-2 text-sm leading-relaxed text-fog/90"><Rich text={e.tradeoff} {lang} /></p>
        </div>
        <a href={localePath(lang, '/benchmarks/')} class="btn btn-primary mt-8">
          {e.more}
          <Icon name="arrow" class="size-4" />
        </a>
      </div>
      <div data-reveal data-reveal-delay="0.1">
        <BenchmarkChart client:visible {lang} labels={b.chart} classNames={b.classes} initialClass="C" initialConc={64} />
      </div>
    </div>
  </div>
</section>
