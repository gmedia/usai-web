---
import Icon from '../Icon.astro';
import { t, localePath, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const r = d.home.researchTeaser;
const arc = d.research.arc;
---

<section id="research" class="section relative" aria-labelledby="research-title">
  <div class="container-page">
    <div class="relative overflow-hidden rounded-3xl border border-line bg-gradient-to-br from-deep/60 via-abyss to-ink p-7 sm:p-12">
      <div class="pointer-events-none absolute -right-24 -top-24 size-80 rounded-full bg-mint/10 blur-3xl" aria-hidden="true"></div>
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div data-reveal>
          <p class="eyebrow">{r.eyebrow}</p>
          <h2 id="research-title" class="mt-4 text-3xl font-bold sm:text-4xl">{r.title}</h2>
          <blockquote class="mt-6 border-l-2 border-mint pl-5 font-heading text-xl font-semibold italic text-paper sm:text-2xl">
            “{r.question}”
          </blockquote>
          <p class="mt-6 max-w-xl text-muted">{r.body}</p>
          <a href={localePath(lang, '/research/')} class="btn btn-ghost mt-8">
            {r.cta}
            <Icon name="arrow" class="size-4" />
          </a>
        </div>
        <ol class="relative space-y-3" data-reveal data-reveal-delay="0.1">
          <span class="absolute bottom-3 left-[0.95rem] top-3 w-px bg-gradient-to-b from-mint/60 via-mint/20 to-mint/60" aria-hidden="true"></span>
          {
            arc.map((a) => (
              <li class="relative flex items-start gap-4">
                <span class:list={['relative z-10 flex size-8 shrink-0 items-center justify-center rounded-full border font-mono text-xs', a.verdict === 'positive' ? 'border-mint/60 bg-mint/15 text-mint' : 'border-caution/50 bg-caution/10 text-caution']}>
                  {a.phase}
                </span>
                <div class="pt-1">
                  <p class="font-heading text-sm font-semibold text-paper">{a.title}</p>
                  <p class:list={['font-mono text-[0.7rem]', a.verdict === 'positive' ? 'text-mint/80' : 'text-caution/80']}>{a.tag}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
