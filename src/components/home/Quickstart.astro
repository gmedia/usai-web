---
import SectionHeading from '../SectionHeading.astro';
import CopyCommand from '../CopyCommand.astro';
import Icon from '../Icon.astro';
import { t, type Lang } from '../../i18n';
import { usai } from '../../config/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const q = d.home.quickstart;
const principles = d.home.principles;
---

<section id="quickstart" class="section relative" aria-labelledby="quickstart-title">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading {lang} id="quickstart-title" eyebrow={q.eyebrow} title={q.title} lead={q.lead} />
        <ol class="mt-10 space-y-5">
          {
            q.steps.map((s, i) => (
              <li data-reveal data-reveal-delay={String(i * 0.06)}>
                <p class="mb-2 flex items-center gap-2 text-sm font-semibold text-paper">
                  <span class="flex size-6 items-center justify-center rounded-full bg-mint/15 font-mono text-xs text-mint">{i + 1}</span>
                  {s.title}
                </p>
                <CopyCommand cmd={s.cmd} {lang} />
              </li>
            ))
          }
        </ol>
        <div class="mt-8 rounded-2xl border border-line p-5" data-reveal>
          <p class="text-sm font-semibold text-paper">{q.dockerTitle}</p>
          <CopyCommand cmd={q.dockerCmd} {lang} class="mt-3" />
          <p class="mt-3 text-xs text-dim">{q.dockerNote}</p>
        </div>
      </div>

      <div class="space-y-6">
        <div class="card p-6 sm:p-7" data-reveal>
          <h3 class="font-mono text-xs uppercase tracking-[0.16em] text-dim">{q.platformsTitle}</h3>
          <ul class="mt-4 divide-y divide-line">
            {
              q.platforms.map((p) => (
                <li class="flex items-center justify-between gap-4 py-3">
                  <span class="text-sm font-medium text-paper">{p.name}</span>
                  <span class="text-right text-xs text-muted">{p.note}</span>
                </li>
              ))
            }
          </ul>
          <a href={usai.supported} class="link mt-4 inline-block text-sm" rel="noopener">SUPPORTED.md ↗</a>
        </div>

        <div class="rounded-2xl border border-caution/25 bg-caution/[0.04] p-6 sm:p-7" data-reveal>
          <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-caution">
            <Icon name="info" class="size-4" /> v{usai.version} · {d.common.status}
          </p>
          <h3 class="mt-3 text-xl font-bold">{q.statusTitle}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{q.statusBody}</p>
          <a href={usai.status_doc} class="link mt-4 inline-block text-sm" rel="noopener">{q.statusCta} ↗</a>
        </div>

        <ul class="grid gap-3 sm:grid-cols-2" aria-label={principles.eyebrow}>
          {
            principles.items.map((p, i) => (
              <li class="rounded-xl border border-line p-4 font-heading text-sm font-semibold leading-snug text-paper" data-reveal data-reveal-delay={String(i * 0.05)}>
                “{p}”
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
