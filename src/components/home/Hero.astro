---
import Rich from '../Rich.astro';
import CopyCommand from '../CopyCommand.astro';
import Icon from '../Icon.astro';
import { t, localePath, type Lang } from '../../i18n';
import { usai, install } from '../../config/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const h = d.home.hero;
---

<section class="hero relative isolate flex min-h-[100svh] items-end overflow-hidden pb-16 pt-28 sm:items-center sm:pb-24" aria-labelledby="hero-title">
  <div class="hero-fallback absolute inset-0 -z-20" aria-hidden="true"></div>
  <canvas class="hero-canvas absolute inset-0 -z-10 size-full" data-hero-canvas aria-hidden="true"></canvas>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-b from-transparent to-ink" aria-hidden="true"></div>

  <div class="container-page">
    <div class="max-w-[46rem]">
      <p class="hero-in inline-flex items-center gap-2 rounded-full border border-mint/25 bg-ink/50 px-3 py-1 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-mint backdrop-blur" style="--i:0">
        <span class="relative flex size-1.5" aria-hidden="true">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-mint opacity-60"></span>
          <span class="relative inline-flex size-1.5 rounded-full bg-mint"></span>
        </span>
        {h.badge} · v{usai.version}
      </p>

      <p class="hero-in mt-6 font-mono text-xs uppercase tracking-[0.22em] text-muted sm:text-sm" style="--i:1">
        {d.meta.tagline}
      </p>

      <h1 id="hero-title" class="mt-3 text-[2.35rem] font-extrabold leading-[1.04] sm:text-6xl lg:text-7xl" style="--i:2">
        <span class="text-gradient">{h.title}</span>
      </h1>

      <p class="hero-in mt-6 max-w-2xl text-base leading-relaxed text-fog/85 sm:text-lg" style="--i:3">
        <Rich text={h.lead} {lang} />
      </p>

      <div class="hero-in mt-8 flex flex-wrap gap-3" style="--i:4">
        <a href={localePath(lang, '/#quickstart')} class="btn btn-primary">
          {h.primary}
          <Icon name="arrow" class="size-4" />
        </a>
        <a href={localePath(lang, '/#how')} class="btn btn-ghost">{h.secondary}</a>
      </div>

      <div class="hero-in mt-8 max-w-xl" style="--i:5">
        <CopyCommand cmd={install.create} {lang} label={h.installLabel} />
        <p class="mt-3 text-xs text-dim">{h.meaning}</p>
      </div>
    </div>
  </div>

  <a href="#problem" class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-[0.65rem] uppercase tracking-[0.3em] text-dim transition-colors hover:text-mint sm:flex" aria-label={h.scrollHint}>
    <span aria-hidden="true">{h.scrollHint}</span>
    <span class="scroll-line block h-10 w-px bg-gradient-to-b from-mint/70 to-transparent" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero-fallback {
    background:
      radial-gradient(60% 50% at 78% 70%, rgb(45 212 191 / 0.18), transparent 70%),
      radial-gradient(80% 60% at 70% 100%, rgb(8 61 58 / 0.9), transparent 70%),
      linear-gradient(180deg, #03110f 0%, #062522 100%);
  }
  .hero-canvas {
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .hero-canvas[data-ready] {
    opacity: 1;
  }
  .hero-in {
    animation: hero-in 1s var(--ease-out-soft) both;
    animation-delay: calc(var(--i) * 90ms + 120ms);
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  .scroll-line {
    animation: scroll-line 2.2s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes scroll-line {
    0% {
      transform: scaleY(0);
    }
    50% {
      transform: scaleY(1);
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  if (canvas) {
    const start = () => import('../../scripts/hero-scene').then((m) => m.mountHero(canvas));
    // The scene is decoration: wait for load, then for an idle moment.
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 2000 }) : setTimeout(start, 400));
    if (document.readyState === 'complete') idle();
    else window.addEventListener('load', idle, { once: true });
  }
</script>
