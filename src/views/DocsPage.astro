---
import { render, getEntry, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import DocsSidebar from '../components/docs/DocsSidebar.astro';
import DocsSearch from '../components/docs/DocsSearch.astro';
import Icon from '../components/Icon.astro';
import { t } from '../i18n';
import { docsOrder, navItemFor } from '../data/docs-nav';
import source from '../data/docs-source.json';
import { readingMinutes } from '../lib/blog';

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const lang = 'en' as const;
const d = t(lang).docs;
const slug = entry.id;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const githubUrl = `https://github.com/${source.repo}/blob/${source.ref}/${entry.data.source}`;

// Previous / next along the sidebar order (section children fall back to their section).
const navItem = navItemFor(slug);
const anchorSlug = navItem?.slug ?? slug;
const isMaintainerDoc = navItem?.group === 'maintainers';
const blurb = navItem?.slug === slug ? navItem.blurb.en : undefined;
const idx = docsOrder.indexOf(anchorSlug);
const prevSlug = docsOrder.includes(slug) && idx > 0 ? docsOrder[idx - 1] : undefined;
const nextSlug = docsOrder.includes(slug) && idx >= 0 && idx < docsOrder.length - 1 ? docsOrder[idx + 1] : undefined;
const prev = prevSlug ? await getEntry('docs', prevSlug) : undefined;
const next = nextSlug ? await getEntry('docs', nextSlug) : undefined;
const section = anchorSlug !== slug ? await getEntry('docs', anchorSlug) : undefined;

const description = `${entry.data.title} — Usai ${source.ref} documentation.`;
const graph = [
  {
    '@type': 'TechArticle',
    headline: entry.data.title,
    inLanguage: 'en',
    isPartOf: { '@id': 'https://usai.sakala.dev/#website' },
    about: { '@id': 'https://usai.sakala.dev/#software' },
    version: source.ref,
    isBasedOn: githubUrl,
  },
];
---

<Base lang={lang} path={`/docs/${slug}/`} page="docs" title={entry.data.title} {description} breadcrumb={d.eyebrow} alternates={['en']} langFallback="/docs/" {graph}>
  <div class="container-page pb-24 pt-24 sm:pt-28">
    <div class="grid gap-8 lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_13rem] xl:gap-10">
      <aside class="hidden lg:block">
        <div class="sticky top-24 max-h-[calc(100dvh-7rem)] overflow-y-auto pb-8 pr-2" data-lenis-prevent>
          <DocsSearch {lang} />
          <div class="mt-6"><DocsSidebar {lang} current={slug} /></div>
        </div>
      </aside>

      <div class="min-w-0">
        <div class="mb-6 flex items-center gap-2 lg:hidden">
          <div class="flex-1"><DocsSearch {lang} dialog={false} /></div>
          <button type="button" popovertarget="docs-drawer" class="inline-flex h-11 items-center gap-2 rounded-xl border border-line px-3 text-sm text-muted">
            <Icon name="menu" class="size-4" />
            {d.menu}
          </button>
        </div>

        <article data-pagefind-body>
          <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-dim" data-pagefind-ignore>
            <a href="/docs/" class="hover:text-mint">{d.eyebrow}</a>
            {section && (
              <>
                <span aria-hidden="true">/</span>
                <a href={`/docs/${section.id}/`} class="hover:text-mint">{section.data.title}</a>
              </>
            )}
            <span class="ml-auto">{readingMinutes(entry.body)} min read</span>
            <span class="rounded-full border border-mint/30 px-2 py-0.5 text-mint">{source.ref}</span>
          </p>
          <h1 class="mt-4 text-3xl font-extrabold leading-tight sm:text-4xl" data-pagefind-meta="title">{entry.data.title}</h1>
          {blurb && (
            <p class="mt-3 text-base text-muted" data-pagefind-ignore>
              <span class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-mint/80">{d.purpose}:</span> {blurb}
            </p>
          )}
          {isMaintainerDoc && (
            <div class="mt-6 flex flex-col gap-3 rounded-xl border border-caution/30 bg-caution/[0.05] p-4 text-sm leading-relaxed text-fog/90 sm:flex-row sm:items-center" data-pagefind-ignore>
              <Icon name="info" class="size-5 shrink-0 text-caution" />
              <p class="flex-1">{d.maintainerBanner}</p>
              <a href="/docs/start/" class="btn btn-ghost !min-h-9 shrink-0 !px-3 text-xs">{d.maintainerBannerCta} →</a>
            </div>
          )}
          <div class="prose-usai docs-prose mt-8">
            <Content />
          </div>
        </article>

        <nav class="mt-14 grid gap-3 sm:grid-cols-2" aria-label="Pagination" data-pagefind-ignore>
          {
            prev ? (
              <a href={`/docs/${prev.id}/`} class="card group p-4 transition-colors hover:border-mint/35">
                <p class="text-xs text-dim">← {d.previous}</p>
                <p class="mt-1 font-heading font-semibold text-paper group-hover:text-mint">{prev.data.title}</p>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a href={`/docs/${next.id}/`} class="card group p-4 text-right transition-colors hover:border-mint/35">
                <p class="text-xs text-dim">{d.next} →</p>
                <p class="mt-1 font-heading font-semibold text-paper group-hover:text-mint">{next.data.title}</p>
              </a>
            )
          }
        </nav>

        <p class="mt-10 border-t border-line pt-6 text-xs leading-relaxed text-dim" data-pagefind-ignore>
          {d.feedback}
          <a href={githubUrl} class="link ml-1">{d.viewSource} ↗</a>
          <span class="mt-1 block font-mono">{d.source}: {entry.data.source} @ {source.ref}{source.commit && ` (${source.commit.slice(0, 7)})`}</span>
        </p>
      </div>

      {
        toc.length > 1 && (
          <aside class="hidden xl:block" aria-label={d.onThisPage}>
            <div class="sticky top-24 max-h-[calc(100dvh-7rem)] overflow-y-auto" data-lenis-prevent>
              <p class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-dim">{d.onThisPage}</p>
              <ul class="mt-3 space-y-1.5 border-l border-line text-[0.8rem]" data-toc>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} class:list={['-ml-px block border-l border-transparent py-0.5 text-dim transition-colors hover:text-paper', h.depth === 3 ? 'pl-6' : 'pl-3']} data-toc-link={h.slug}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )
      }
    </div>
  </div>

  <div id="docs-drawer" popover="auto" class="docs-drawer" data-lenis-prevent>
    <div class="mb-4 flex items-center justify-between">
      <span class="eyebrow">{d.menu}</span>
      <button type="button" popovertarget="docs-drawer" popovertargetaction="hide" class="inline-flex size-10 items-center justify-center rounded-lg border border-line text-paper" aria-label="Close">
        <Icon name="close" class="size-5" />
      </button>
    </div>
    <DocsSidebar {lang} current={slug} />
  </div>
</Base>

<style>
  .docs-drawer {
    position: fixed;
    inset: 0 auto 0 0;
    width: min(20rem, 88vw);
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 1rem;
    overflow-y: auto;
    border: 0;
    border-right: 1px solid var(--color-line);
    background: rgb(3 17 15 / 0.98);
  }
  .docs-drawer::backdrop {
    background: rgb(0 0 0 / 0.5);
  }
  [data-toc-link][data-active] {
    color: var(--color-mint);
    border-color: var(--color-mint);
  }
</style>

<script>
  // Highlight the section being read in the right-hand table of contents.
  const links = new Map(Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')).map((a) => [a.dataset.tocLink!, a]));
  if (links.size) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute('data-active'));
          links.get(e.target.id)?.setAttribute('data-active', '');
        }
      },
      { rootMargin: '-15% 0px -75% 0px' },
    );
    document.querySelectorAll('.docs-prose h2[id], .docs-prose h3[id]').forEach((h) => io.observe(h));
  }
</script>
