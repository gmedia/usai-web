---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import DocsSidebar from '../components/docs/DocsSidebar.astro';
import DocsSearch from '../components/docs/DocsSearch.astro';
import Icon from '../components/Icon.astro';
import { t, localePath, type Lang } from '../i18n';
import { docsNav } from '../data/docs-nav';
import source from '../data/docs-source.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang).docs;
const s = t(lang).docsStart;
/** Synced docs are English-only at /docs; site pages are localised. */
const href = (h: string) => (h.startsWith('/docs/') && h !== '/docs/start/' ? h : localePath(lang, h));
---

<Base {lang} path="/docs/" page="docs" title={d.meta.title} description={d.meta.description} breadcrumb={d.eyebrow}>
  <div class="container-page pb-24 pt-28 sm:pt-36">
    <div class="grid gap-10 lg:grid-cols-[15rem_minmax(0,1fr)]">
      <aside class="hidden lg:block">
        <div class="sticky top-24 max-h-[calc(100dvh-7rem)] overflow-y-auto pb-8 pr-2" data-lenis-prevent>
          <DocsSidebar {lang} />
        </div>
      </aside>

      <div class="min-w-0">
        <SectionHeading {lang} as="h1" eyebrow={d.eyebrow} title={d.title} lead={d.lead} />
        <p class="mt-5 flex flex-wrap items-center gap-2 font-mono text-xs text-dim">
          <span class="rounded-full border border-mint/30 px-2 py-0.5 text-mint">{d.version} {source.ref}</span>
          <span>{d.synced} · {source.commit.slice(0, 7)}</span>
        </p>
        {
          d.englishOnly && (
            <p class="mt-5 max-w-2xl rounded-xl border border-line bg-white/[0.02] p-4 text-sm leading-relaxed text-muted">
              {d.englishOnly}{' '}
              <a class="link" href={localePath(lang, '/glossary/')}>
                {t(lang).nav.glossary} →
              </a>
            </p>
          )
        }

        <div class="mt-8 max-w-xl"><DocsSearch {lang} /></div>

        <a
          href={localePath(lang, '/docs/start/')}
          class="group mt-10 flex flex-col gap-4 rounded-2xl border border-mint/30 bg-gradient-to-br from-deep/70 to-ink p-6 transition-colors hover:border-mint/60 sm:flex-row sm:items-center sm:p-8"
        >
          <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-mint/15 text-mint" aria-hidden="true">
            <Icon name="spark" class="size-6" />
          </span>
          <span class="flex-1">
            <span class="eyebrow block">{s.eyebrow}</span>
            <span class="mt-1 block font-heading text-2xl font-bold text-paper">{s.title}</span>
            <span class="mt-1 block text-sm text-muted">{docsNav[0].items[0].blurb[lang]}</span>
          </span>
          <Icon name="arrow" class="size-6 text-mint transition-transform group-hover:translate-x-1" />
        </a>

        <h2 class="mt-14 text-2xl font-bold sm:text-3xl">{d.pathsTitle}</h2>
        <ul class="mt-6 grid gap-4 md:grid-cols-3">
          {
            d.paths.map((p) => (
              <li class="card flex flex-col p-5">
                <h3 class="font-heading text-lg font-semibold">{p.title}</h3>
                <p class="mt-1.5 flex-1 text-sm leading-relaxed text-muted">{p.body}</p>
                <ul class="mt-4 space-y-1.5">
                  {p.links.map((l) => (
                    <li>
                      <a href={href(l.href)} class="inline-flex items-center gap-1 text-sm text-mint hover:underline">
                        {l.label} <Icon name="arrow" class="size-3.5" />
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>

        <h2 class="mt-16 text-2xl font-bold sm:text-3xl">{d.allPages}</h2>
        <div class="mt-6 space-y-10">
          {
            docsNav.map((g) => (
              <section aria-labelledby={`g-${g.key}`}>
                <h3 id={`g-${g.key}`} class="font-mono text-xs uppercase tracking-[0.16em] text-dim">
                  {d.groups[g.key]}
                </h3>
                {g.collapsed && <p class="mt-1 text-xs text-dim">{d.maintainersHint}</p>}
                <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                  {g.items.map((i) => (
                    <li>
                      <a
                        href={i.href ? localePath(lang, i.href) : `/docs/${i.slug}/`}
                        class:list={['group block h-full rounded-xl border p-4 transition-colors', g.collapsed ? 'border-line/60 hover:border-line' : 'border-line hover:border-mint/35']}
                      >
                        <span class:list={['font-heading font-semibold', g.collapsed ? 'text-muted' : 'text-paper group-hover:text-mint']}>{i.label}</span>
                        <span class="mt-1 block text-sm leading-relaxed text-dim">{i.blurb[lang]}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Base>
