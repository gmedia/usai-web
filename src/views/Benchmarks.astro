---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Rich from '../components/Rich.astro';
import Icon from '../components/Icon.astro';
import BenchmarkChart from '../components/islands/BenchmarkChart.tsx';
import { t, type Lang } from '../i18n';
import { sources } from '../config/site';
import { classIds, classRoutes, cost, laravelRatio, measuredAt, probe, runtimeLabels } from '../data/benchmarks';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const b = d.benchmarks;
const fmt = new Intl.NumberFormat(lang === 'id' ? 'id-ID' : 'en-US', { maximumFractionDigits: 3 });
const costRuntimes = ['usai', 'node', 'nodeCluster', 'bun', 'deno', 'axum'] as const;
const costClasses = ['A', 'C', 'E'] as const;

const graph = [
  {
    '@type': 'Dataset',
    name: 'Usai concurrency sweep (2026-09-23)',
    description: b.meta.description,
    url: sources.sweep,
    dateCreated: measuredAt,
    license: 'https://www.apache.org/licenses/LICENSE-2.0',
    creator: { '@id': 'https://usai.sakala.dev/#sakala' },
    variableMeasured: ['requests per second', 'CPU ms per request', 'RSS MiB'],
  },
];

const sourceList = [
  { label: '2026-09-23-sweep.md', href: sources.sweep },
  { label: 'BENCHMARKS.md', href: sources.benchmarks },
  { label: '2026-09-20-p8e-efficiency.md', href: sources.efficiency },
  { label: '2026-09-18-p5-p6-qualification.md', href: sources.reliability },
  { label: 'STATUS.md', href: sources.status },
];
---

<Base {lang} path="/benchmarks/" page="benchmarks" title={b.meta.title} description={b.meta.description} breadcrumb={d.nav.evidence} {graph}>
  <section class="relative overflow-hidden pb-12 pt-32 sm:pt-40">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_50%_at_70%_0%,rgb(8_61_58/0.7),transparent)]" aria-hidden="true"></div>
    <div class="container-page">
      <SectionHeading {lang} as="h1" eyebrow={b.eyebrow} title={b.title} lead={b.lead} />
    </div>
  </section>

  <section class="pb-16" aria-labelledby="setup-title">
    <div class="container-page grid gap-6 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="card p-6" data-reveal>
        <h2 id="setup-title" class="font-mono text-xs uppercase tracking-[0.16em] text-dim">{b.setupTitle}</h2>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
          {b.setup.map((s) => <li class="flex gap-2"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-mint" aria-hidden="true" />{s}</li>)}
        </ul>
      </div>
      <div class="card p-6" data-reveal data-reveal-delay="0.06">
        <h2 class="font-mono text-xs uppercase tracking-[0.16em] text-dim">{b.classesTitle}</h2>
        <dl class="mt-4 grid gap-3 sm:grid-cols-2">
          {
            classIds.map((id) => (
              <div class="rounded-xl border border-line p-3">
                <dt class="flex items-baseline gap-2">
                  <span class="font-mono text-xs text-mint">{id}</span>
                  <span class="font-heading text-sm font-semibold text-paper">{b.classes[id].name}</span>
                </dt>
                <dd class="mt-1 text-xs text-muted">{b.classes[id].body}</dd>
                <dd class="mt-1 font-mono text-[0.7rem] text-dim">{classRoutes[id]}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="pb-20" aria-label={d.home.evidence.chartTitle}>
    <div class="container-page" data-reveal>
      <BenchmarkChart client:visible {lang} labels={b.chart} classNames={b.classes} initialClass="A" initialConc={64} />
    </div>
  </section>

  <section class="pb-20" aria-labelledby="short-title">
    <div class="container-page">
      <h2 id="short-title" class="text-3xl font-bold sm:text-4xl" data-reveal>{b.shortTitle}</h2>
      <dl class="mt-8 divide-y divide-line overflow-hidden rounded-2xl border border-line">
        {
          b.short.map((s) => (
            <div class="grid gap-2 p-5 sm:grid-cols-[14rem_1fr] sm:gap-6 sm:p-6" data-reveal>
              <dt class="font-heading font-semibold text-paper">vs {s.vs}</dt>
              <dd class="text-sm leading-relaxed text-muted sm:text-base">{s.verdict}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="pb-20" aria-labelledby="cost-title">
    <div class="container-page">
      <div class="max-w-3xl" data-reveal>
        <h2 id="cost-title" class="text-3xl font-bold sm:text-4xl">{b.costTitle}</h2>
        <p class="mt-3 text-muted">{b.costLead}</p>
      </div>
      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        {
          [
            { title: b.cpuLabel, data: cost.cpuMs },
            { title: b.rssLabel, data: cost.rssMiB },
          ].map((tbl) => (
            <div class="card overflow-x-auto p-5" data-reveal>
              <table class="w-full min-w-[28rem] text-left text-sm">
                <caption class="pb-3 text-left font-mono text-xs uppercase tracking-[0.14em] text-dim">{tbl.title}</caption>
                <thead>
                  <tr class="border-b border-line text-xs text-dim">
                    <th scope="col" class="py-2 pr-3 font-normal">{b.chart.runtime}</th>
                    {costClasses.map((c) => <th scope="col" class="py-2 pr-3 text-right font-normal">{c} · {b.classes[c].name}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {costRuntimes.map((rt) => (
                    <tr class="border-b border-line/60 last:border-0">
                      <th scope="row" class:list={['py-2 pr-3 font-normal', rt === 'usai' ? 'text-mint' : 'text-muted']}>{runtimeLabels[rt]}</th>
                      {costClasses.map((c) => (
                        <td class:list={['py-2 pr-3 text-right font-mono tabular-nums', rt === 'usai' ? 'text-paper' : 'text-fog/80']}>{fmt.format(tbl.data[c][rt])}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))
        }
      </div>
      <p class="mt-5 max-w-3xl text-sm leading-relaxed text-muted" data-reveal><Rich text={b.costNote} {lang} /></p>
    </div>
  </section>

  <section class="pb-20" aria-labelledby="probe-title">
    <div class="container-page grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div data-reveal>
        <h2 id="probe-title" class="text-3xl font-bold sm:text-4xl">{b.probeTitle}</h2>
        <p class="mt-3 text-muted">{b.probeLead}</p>
        <p class="mt-5 text-sm leading-relaxed text-muted">{b.probeNote}</p>
      </div>
      <div class="card overflow-x-auto p-5" data-reveal data-reveal-delay="0.06">
        <table class="w-full min-w-[26rem] text-left text-sm">
          <thead>
            <tr class="border-b border-line text-xs text-dim">
              <th scope="col" class="py-2 pr-3 font-normal">{b.probeServer}</th>
              <th scope="col" class="py-2 font-normal">{b.probeAnswers}</th>
            </tr>
          </thead>
          <tbody>
            {
              probe.map((p) => (
                <tr class="border-b border-line/60 last:border-0">
                  <th scope="row" class:list={['py-3 pr-3 font-normal', p.fresh ? 'text-mint' : 'text-muted']}>{p.server}</th>
                  <td class:list={['py-3 font-mono tracking-wider', p.fresh ? 'text-mint' : 'text-caution']}>{p.answers}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="pb-20" aria-labelledby="laravel-title">
    <div class="container-page">
      <div class="max-w-3xl" data-reveal>
        <h2 id="laravel-title" class="text-3xl font-bold sm:text-4xl">{b.laravelTitle}</h2>
        <p class="mt-3 text-muted">{b.laravelLead}</p>
      </div>
      <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        {
          classIds.map((id, i) => (
            <li class="card p-4 text-center" data-reveal data-reveal-delay={String(i * 0.04)}>
              <p class="font-heading text-3xl font-extrabold text-mint">{laravelRatio[id]}</p>
              <p class="mt-1 text-xs text-muted"><span class="font-mono text-mint/70">{id}</span> {b.classes[id].name}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="pb-20" aria-labelledby="eff-title">
    <div class="container-page">
      <div class="max-w-3xl" data-reveal>
        <h2 id="eff-title" class="text-3xl font-bold sm:text-4xl">{b.efficiencyTitle}</h2>
        <p class="mt-3 text-muted">{b.efficiencyLead}</p>
      </div>
      <ul class="mt-8 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {
          b.efficiency.map((e) => (
            <li class="bg-ink p-6" data-reveal>
              <p class="font-heading text-3xl font-extrabold text-paper">{e.value}</p>
              <p class="mt-1 text-sm text-fog">{e.label}</p>
              <p class="mt-1 text-xs text-dim">{e.note}</p>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <div class="card p-6" data-reveal>
          <h3 class="font-mono text-xs uppercase tracking-[0.16em] text-dim">{b.floorsTitle}</h3>
          <ul class="mt-4 space-y-4">
            {
              b.floors.map((f) => (
                <li>
                  <p class="font-heading text-xl font-bold text-paper">{f.value}</p>
                  <p class="text-sm text-fog">{f.label}</p>
                  <p class="text-xs text-dim">{f.note}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="card p-6" data-reveal data-reveal-delay="0.06">
          <h3 class="font-mono text-xs uppercase tracking-[0.16em] text-dim">{b.reliabilityTitle}</h3>
          <ul class="mt-4 space-y-3">
            {
              b.reliability.map((r) => (
                <li class="flex items-baseline gap-3">
                  <span class="w-20 shrink-0 font-heading text-lg font-bold text-mint">{r.value}</span>
                  <span class="text-sm text-muted">{r.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-24" aria-labelledby="not-title">
    <div class="container-page grid gap-6 lg:grid-cols-2">
      <div class="rounded-2xl border border-caution/25 bg-caution/[0.04] p-6 sm:p-7" data-reveal>
        <h2 id="not-title" class="flex items-center gap-2 text-xl font-bold"><Icon name="warn" class="size-5 text-caution" /> {b.notMeasuredTitle}</h2>
        <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-muted">
          {b.notMeasured.map((n) => <li class="flex gap-2"><span aria-hidden="true" class="text-caution">—</span>{n}</li>)}
        </ul>
      </div>
      <div class="card p-6 sm:p-7" data-reveal data-reveal-delay="0.06">
        <h2 class="text-xl font-bold">{b.methodTitle}</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">{b.method}</p>
        <ul class="mt-5 space-y-2">
          {
            sourceList.map((s) => (
              <li>
                <a href={s.href} class="inline-flex items-center gap-1.5 font-mono text-xs text-mint/90 hover:text-mint" rel="noopener">
                  <Icon name="doc" class="size-3.5" /> {s.label} <Icon name="external" class="size-3" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>
